# Backend REST API base (MUST include the /api suffix). REQUIRED.
VITE_API_URL=http://localhost:3000/api

# Public site origin — used for canonical URLs, SEO tags and the sitemap.
# Production: https://alimenture.in (no trailing slash).
VITE_APP_URL=http://localhost:5173

# Optional: a release/commit id, attached to client error reports.
# VITE_RELEASE=

# NOTE: the frontend does NOT use the Firebase client SDK. All Firebase access
# goes through the backend, so no VITE_FIREBASE_* variables are needed — do not
# add them.

# Production builds always use https://alimenture.in when this is a localhost
# URL, so local values can't leak into canonical tags or the sitemap.
# Optional: Google Search Console HTML-tag verification token (content="…").
# VITE_GSC_VERIFICATION=
