# Backend REST API base (MUST include the /api suffix). REQUIRED.
VITE_API_URL=http://localhost:3000/api

# Public site origin — used for canonical URLs, SEO tags and the sitemap.
VITE_APP_URL=http://localhost:5173

# Optional: a release/commit id, attached to client error reports.
# VITE_RELEASE=

# NOTE: the frontend does NOT use the Firebase client SDK. All Firebase access
# goes through the backend, so no VITE_FIREBASE_* variables are needed — do not
# add them.
